SOURCE_CODE_URL=https://github.com/workpiece-gr/open-slicer-service
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173,https://workpiece.gr,https://www.workpiece.gr,https://garagefab-prototype.chr-a-karagiannis.chatgpt.site
ORCA_BIN=/opt/orca/squashfs-root/AppRun
ORCA_VERSION=2.4.2
PROFILE_ROOT=/app/profiles
MAX_UPLOAD_BYTES=52428800
SLICE_TIMEOUT_SECONDS=180
MAX_PREVIEW_MOVES=30000
MAX_PROJECT_QUANTITY=50
MAX_PROJECT_BYTES=83886080
ENABLE_EXPERIMENTAL_PROJECT_API=0
# Required when /v1/project is enabled. Keep this server-to-server secret out of browsers.
WORKPIECE_PROJECT_API_TOKEN=
# /v1/project is intentionally serialized to one active Orca project build per service process.
PROJECT_QUEUE_TIMEOUT_SECONDS=300
# Optional explicit provenance fallback outside Railway.
SOURCE_COMMIT_SHA=
# Orca resource presets bundled inside the pinned AppImage.
ORCA_RESOURCE_ROOT=/opt/orca/squashfs-root/resources/profiles
